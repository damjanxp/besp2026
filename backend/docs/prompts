KeyStore ks = KeyStore.getInstance("PKCS12", "BC")
ks.load(null, null)
ks.setKeyEntry(alias, privateKey, keystorePassword.toCharArray(), new Certificate[]{certificate})
Create directory if not exists: Path keystorePath = Paths.get(keystoreDir, alias + ".p12")
